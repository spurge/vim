# Ghostty — the terminal this Neovim config is tuned for.
#
# Installed by `make ghostty`, which links this file to
# ~/.config/ghostty/config.ghostty. Reload a running Ghostty with
# Cmd+Shift+, — font changes apply to open windows too.
#
# `ghostty +show-config --default --docs` lists every option with its docs.

# ── Theme ────────────────────────────────────────────────────────────────
# Follows the macOS appearance, sunrise/sunset schedule included. This is
# the first link of the chain in lua/core/theme.lua: Ghostty swaps palette,
# tells Neovim (mode 2031 + OSC 11), Neovim flips 'background'.
#
# A misspelt name is silently ignored — `ghostty +list-themes` for the list.
theme = light:Gruvbox Light Hard,dark:Gruvbox Dark Hard

# ── Title bar ────────────────────────────────────────────────────────────
# The folder in the title bar is macOS's proxy icon for the working
# directory — Ghostty has no per-program icon like iTerm2's. Hidden, and
# Neovim puts its own logo in the title text instead (see the font below).
macos-titlebar-proxy-icon = hidden

# ── Font ─────────────────────────────────────────────────────────────────
# The Nerd Font build, for the icons in the sidebar, statusline and
# fzf-lua. The proportional "Nerd Font" rather than "Nerd Font Mono": the
# Mono build squeezes every icon into one cell until it's unreadable,
# while Ghostty lets an icon overflow into the next cell, which is what
# the icons are drawn for.
#
#   brew install --cask font-mononoki-nerd-font
#   brew install --cask font-fantasque-sans-mono-nerd-font
#
# `ghostty +list-fonts | grep -i <name>` to check the exact family name.
# Swap the pairs below to switch; the size goes with the font.
font-family = Mononoki Nerd Font
font-size = 14

# Fantasque has a small x-height, so it reads a size or two smaller than
# most monospace fonts at the same point size — 13 (Ghostty's default) is
# cramped with it.
# font-family = FantasqueSansM Nerd Font
# font-size = 15

# The title bar and tabs are drawn in the macOS system font unless told
# otherwise, and that has no Nerd Font glyphs — so the Neovim logo that
# lua/settings.lua puts in front of the title (iterm.title_icon) would be
# a blank box. Keep this in step with font-family above.
window-title-font-family = Mononoki Nerd Font

# Both fonts ship a few ligatures (`->`, `<=`, `==` …) in their default
# contextual alternates. Uncomment to draw every character on its own.
# font-feature = -calt
